# ==========================================
# AI Video Production Studio Environment Config
# ==========================================

# 1. Google Gemini API (Recommended - Primary Story Writer)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Note: GOOGLE_API_KEY is also accepted as an alias

# 2. OpenAI API (Optional - Cascade Fallback Tier)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 3. RunPod GPU Pod (Optional - for Cloud ComfyUI Wan 3.0 diffusion)
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_COMFY_URL=https://<your-pod-id>-8188.proxy.runpod.net

# 4. RunPod Serverless (Optional - for high-throughput parallel rendering)
RUNPOD_SERVERLESS_ENDPOINT_ID=your_serverless_endpoint_id_here
MAX_SERVERLESS_CONCURRENCY=4

# 5. Pipeline Timeouts & Generation Settings (Optional)
LLM_TIMEOUT_SEC=10.0
COMFY_TIMEOUT_SEC=900
