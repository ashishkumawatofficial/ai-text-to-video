{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectorManifest",
  "description": "Storyboard and production manifest contract ingested or generated by the Director",
  "type": "object",
  "required": ["title", "genre", "ingestion_mode", "scenes"],
  "properties": {
    "title": { "type": "string" },
    "genre": { "type": "string", "enum": ["riddle", "cinematic_story", "action"] },
    "ingestion_mode": { "type": "string", "enum": ["autonomous_director", "directed_studio"] },
    "aspect_ratio": { "type": "string", "default": "9:16" },
    "fps": { "type": "integer", "default": 30 },
    "target_duration_sec": { "type": "number", "minimum": 15, "maximum": 90 },
    "character_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "name"],
        "properties": {
          "character_id": { "type": "string" },
          "name": { "type": "string" },
          "reference_images": { "type": "array", "items": { "type": "string" } },
          "identity_prompt": { "type": "string" },
          "ip_adapter_weight": { "type": "number", "default": 0.75 }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["beat_index", "name", "visual_strategy"],
        "properties": {
          "beat_index": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "duration_sec": { "type": "number", "minimum": 1.0 },
          "visual_strategy": {
            "type": "string",
            "enum": ["PROGRAMMATIC_HYBRID", "START_END_INTERPOLATION", "FLAT_RATE_DIFFUSION"]
          },
          "visual_prompt": { "type": "string" },
          "dialogue_text": { "type": "string" },
          "image_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file_path", "role"],
              "properties": {
                "file_path": { "type": "string" },
                "role": {
                  "type": "string",
                  "enum": [
                    "STYLE_REFERENCE",
                    "CHARACTER_IMAGE",
                    "STORYBOARD_IMAGE",
                    "SCENE_IMAGE",
                    "START_FRAME",
                    "END_FRAME"
                  ]
                }
              }
            }
          },
          "continuity": {
            "type": "object",
            "properties": {
              "chain_from_previous": { "type": "boolean", "default": false },
              "motion_continuation_prompt": { "type": "string" }
            }
          },
          "sound_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sfx_name", "offset_sec"],
              "properties": {
                "sfx_name": { "type": "string" },
                "offset_sec": { "type": "number" },
                "volume": { "type": "number", "default": 1.0 }
              }
            }
          }
        }
      }
    }
  }
}
